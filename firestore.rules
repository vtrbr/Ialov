rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function validProject() {
      return request.resource.data.keys().hasOnly([
        'name', 'description', 'template', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    function validConversation() {
      return request.resource.data.keys().hasOnly([
        'title', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 160
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    function validArtifact() {
      return request.resource.data.keys().hasOnly([
        'filePath', 'language', 'content', 'version', 'summary', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.filePath is string
      && request.resource.data.filePath.size() > 0
      && request.resource.data.filePath.size() <= 240
      && !request.resource.data.filePath.matches('.*(^|/)\\.\\.(/|$).*')
      && request.resource.data.language is string
      && request.resource.data.content is string
      && request.resource.data.content.size() <= 524288
      && request.resource.data.version is int
      && request.resource.data.version > 0
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if owns(userId);
      allow list: if false;
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if owns(userId)
        && onlyChanges(['displayName', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;

      match /projects/{projectId} {
        allow read: if owns(userId);
        allow create: if owns(userId) && validProject();
        allow update: if owns(userId) && validProject();
        allow delete: if owns(userId);

        match /conversations/{conversationId} {
          allow read: if owns(userId);
          allow create: if owns(userId) && validConversation();
          allow update: if owns(userId) && validConversation();
          allow delete: if owns(userId);

          match /messages/{messageId} {
            allow read: if owns(userId);
            // Mensagens do agente devem ser escritas pelo servidor usando Admin SDK.
            allow create: if owns(userId)
              && request.resource.data.keys().hasOnly(['role', 'content', 'createdAt'])
              && request.resource.data.role == 'user'
              && request.resource.data.content is string
              && request.resource.data.content.size() > 0
              && request.resource.data.content.size() <= 50000
              && request.resource.data.createdAt is timestamp;
            allow update, delete: if false;
          }
        }

        match /artifacts/{artifactId} {
          allow read: if owns(userId);
          allow create: if owns(userId) && validArtifact();
          allow update: if owns(userId) && validArtifact();
          allow delete: if owns(userId);

          match /versions/{versionId} {
            allow read: if owns(userId);
            // Checkpoints são criados somente pelo backend confiável.
            allow write: if false;
          }
        }

        match /agentRuns/{runId} {
          allow read: if owns(userId);
          // Execuções, eventos e telemetria são sempre responsabilidade do backend.
          allow write: if false;

          match /events/{eventId} {
            allow read: if owns(userId);
            allow write: if false;
          }
        }
      }

      // Preferências sem chaves. Chaves de provedores ficam somente no backend.
      match /settings/{settingId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.keys().hasOnly([
            'autonomyMode', 'preferredTextSlot', 'firebaseProjectId',
            'firebaseAuthConfigured', 'firestoreConfigured', 'updatedAt'
          ])
          && request.resource.data.autonomyMode in ['ask', 'autonomous']
          && request.resource.data.updatedAt is timestamp;
        allow delete: if owns(userId);
      }
    }

    // Defesa em profundidade: nenhuma outra coleção é acessível diretamente pelo cliente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
